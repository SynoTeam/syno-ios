// Shared analytics build settings. Local secrets override the empty default below.
AMPLITUDE_API_KEY =
#include? "Secrets.xcconfig"

// Debug 빌드는 개발 중 이벤트가 운영 통계에 섞이지 않도록 분석 이벤트를 보내지 않는다 (#132).
// 분석 이벤트를 직접 확인해야 하면 Xcode 스킴 → Run → Arguments → Environment Variables에
// AMPLITUDE_API_KEY를 넣는다. SynoApp은 환경변수를 Info.plist 값보다 먼저 읽는다.
AMPLITUDE_API_KEY[config=Debug] =
